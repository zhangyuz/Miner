GITHUB_TOKEN=
RUNTIME_ENV=
MINER_ROOT=
MAIL_SENDER_PWD=
MAIL_SENDER=
MAIL_RECEIVERS=
GIT_USER_NAME=
GIT_USER_EMAIL=
# Gemini CLI - API key for headless authentication in Docker
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Discord Bot (REST): shared token for any feature that sends notifications
DISCORD_BOT_TOKEN=
# Optional override; default https://discord.com/api/v10
DISCORD_API_BASE=

# Wedge-pop AI analysis -> Discord (set ENABLED=1 or true to send)
# Bot needs Send Messages in listed channels; DMs require user shares a guild with the bot.
DISCORD_OLIVER_KELL_ENABLED=
DISCORD_OLIVER_KELL_CHANNEL_IDS=
DISCORD_OLIVER_KELL_USER_IDS=

# For ib gate way, refer:https://github.com/gnzsnz/ib-gateway-docker/pkgs/container/ib-gateway
TWS_USERID=
TWS_PASSWORD=
TRADING_MODE=paper
TWS_SETTINGS_PATH=
TWS_ACCEPT_INCOMING=accept
READ_ONLY_API=no
VNC_SERVER_PASSWORD=
TWOFA_TIMEOUT_ACTION=restart
BYPASS_WARNING=
AUTO_RESTART_TIME=03:00 AM
AUTO_LOGOFF_TIME=
TWS_COLD_RESTART=
SAVE_TWS_SETTINGS=
RELOGIN_AFTER_TWOFA_TIMEOUT=yes
TWOFA_EXIT_INTERVAL=60
TWOFA_DEVICE=
EXISTING_SESSION_DETECTED_ACTION=primary
ALLOW_BLIND_TRADING=yes
TIME_ZONE=America/Toronto
TZ=America/Toronto
CUSTOM_CONFIG=
JAVA_HEAP_SIZE=1024
SSH_TUNNEL=
SSH_OPTIONS=
SSH_ALIVE_INTERVAL=
SSH_ALIVE_COUNT=
SSH_PASSPHRASE=
SSH_REMOTE_PORT=
SSH_USER_TUNNEL=
SSH_RESTART=
SSH_VNC_PORT=
