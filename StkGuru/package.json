{
  "name": "stkguru",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test",
    "dev:staging": "vite --mode staging",
    "dev:ghpages": "vite --mode ghpages",
    "dev:ghpages-dev": "vite --mode ghpages-dev",
    "build": "tsc -b && vite build",
    "build:test": "tsc -b && vite build --mode test",
    "build:staging": "tsc -b && vite build --mode staging",
    "build:production": "tsc -b && vite build --mode production",
    "build:ghpages": "tsc -b && vite build --mode ghpages",
    "build:ghpages-dev": "tsc -b && vite build --mode ghpages-dev",
    "preview": "vite preview",
    "preview:test": "vite preview --mode test",
    "preview:staging": "vite preview --mode staging",
    "preview:production": "vite preview --mode production",
    "build:docker": "tsc -b && vite build --mode docker",
    "preview:ghpages-dev": "vite preview --mode ghpages-dev",
    "lint": "eslint ."
  },
  "dependencies": {
    "@tanstack/react-query": "^5.83.0",
    "highcharts": "^12.3.0",
    "highcharts-react-official": "^3.2.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-intersection-observer": "^9.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4"
  }
}
